# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Anything a browser may read is declared PUBLIC_ *and* registered in
# astro.config.mjs under env.schema with context:'client'. Everything else is
# context:'server', access:'secret' — importing one of those from client code
# is a build error, not a code-review catch.

# Supabase → Settings → API keys. SHARED PROJECT with jmcc-portal: use the same
# project, and never create or alter a Portal-owned table (competitions,
# disciplines, profiles, teams, team_*). Dashboard tables are prefixed news_.
# These are the current key names; older projects call the same two "anon" and
# "service_role".
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=              # server only — bypasses RLS entirely

# Ingest sources (Sprint 2). Free tier: 200 credits/day, ~88-103 budgeted.
NEWSDATA_API_KEY=                 # server only
MARKETAUX_API_KEY=                # server only

# Weekly digest (Sprint 4).
RESEND_API_KEY=                   # server only

# Vercel cron endpoints are publicly reachable — both cron routes check this
# as a bearer token before doing anything.
CRON_SECRET=                      # server only

PUBLIC_SITE_URL=https://news.jmccjmsb.ca
